class Main {
    public static void main(String[] args) {
        int x = 5;
        float y = 2.5;
        boolean flag = true;
        int sum = 0;
        for (int i = 0; i < x; i = i + 1) {
            sum = sum + i;
        }
        if (sum > 10 && flag) {
            System.out.println(sum);
        } else {
            System.out.println(0);
        }
        while (x > 0) {
            x = x - 1;
            System.out.println(x);
        }
    }
}
