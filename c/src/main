#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "ast.h"
#include "symbol_table.h"
#include "semantic.h"
#include "codegen.h"

extern FILE *yyin;
extern int yyparse(void);
extern ASTNode *g_program;
extern int g_trace_lex;

int main(int argc, char **argv) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <source-file> [--ast] [--symtab]\n", argv[0]);
        return 1;
    }
    yyin = fopen(argv[1], "r");
    if (!yyin) { perror("fopen"); return 1; }

    int show_ast = 0, show_symtab = 0;
    for (int i = 2; i < argc; i++) {
        if (!strcmp(argv[i], "--ast")) show_ast = 1;
        if (!strcmp(argv[i], "--symtab")) show_symtab = 1;
    }
    (void)show_ast; (void)show_symtab;

    printf("=== Phase 1: Lexical Analysis (Token Stream) ===\n");
    printf("%-16s %-14s %s\n", "TOKEN", "LEXEME", "LINE");
    printf("------------------------------------------\n");
    g_trace_lex = 1;
    int parse_status = yyparse();
    g_trace_lex = 0;
    printf("\n");

    if (parse_status != 0) {
        fprintf(stderr, "=== Phase 2: Syntax Analysis ===\nParsing failed.\n");
        fclose(yyin);
        return 1;
    }
    printf("=== Phase 2: Syntax Analysis ===\n");
    printf("Parse successful. Parse tree constructed.\n\n");
    printf("-- Parse Tree --\n");
    ast_print_tree_centered(g_program, 0);
    printf("\n");

    printf("=== Phase 3: Abstract Syntax Tree (AST) ===\n");
    ast_print(g_program, 0);
    printf("\n");

    printf("=== Phase 4: Symbol Table Construction ===\n");
    SymbolTable *table = symtab_new();
    int ok = semantic_analyze(g_program, table);
    symtab_print(table);
    printf("\n");

    printf("=== Phase 5: Semantic Analysis ===\n");
    if (ok) {
        printf("No semantic errors found. All type checks passed.\n\n");
        printf("-- Type-Annotated Parse Tree --\n");
        ast_print_tree_centered(g_program, 1);
        printf("\n");
    } else {
        fprintf(stderr, "Semantic analysis failed (see errors above). Aborting before code generation.\n");
        symtab_free(table);
        ast_free(g_program);
        fclose(yyin);
        return 1;
    }

    printf("=== Phase 6: Intermediate Code Generation (TAC) ===\n");
    codegen_generate(g_program);

    symtab_free(table);
    ast_free(g_program);
    fclose(yyin);
    return 0;
}
