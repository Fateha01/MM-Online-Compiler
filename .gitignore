# Flex/Bison generated files (regenerated by `make` -- do not hand-edit or commit)
src/parser/parser.tab.c
src/parser/parser.tab.h
src/lexer/lex.yy.c

# Build output
build/
mc-compiler
mc-compiler.exe

# Python runtime artifacts from either local server (web/server.py or
# playground/server.py) -- the generic pattern below covers any depth
__pycache__/
*.pyc

# OS / editor junk
.DS_Store
*.swp

# NOTE: .vscode/ is intentionally NOT ignored here -- it holds the shared
# build/test/debug task config for the whole team (see README's "Using VS
# Code" section), so it should be committed, not local-only.
